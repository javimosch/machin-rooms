// machin-rooms — a self-hostable real-time chat server, in one MFL binary.
//
// Open the page, pick a room + a name, and chat live over WebSockets — messages,
// join/leave notices, and a live member count, broadcast to everyone in the room. No
// broker, no Node: the WebSocket server (handshake + RFC 6455 frame codec) is pure MFL
// in framework/ws.src, and the fan-out is the same lock-free hub-goroutine pattern as
// machin-live (a chan inside a struct + a []Sub registry).
//
// Each connection runs TWO goroutines: a reader (the ws handler loop) turning inbound
// frames into "say" commands, and a writer draining the connection's outbound channel of
// broadcasts. They share the fd (read + write are independent directions).
//
// Config (env): MACHROOMS_PORT (48500) · MACHROOMS_TITLE.

type Sub struct {
    id      string
    room    string
    name    string
    out     chan string
    fd      int
    pending int       // bytes queued to this member and not yet reported written; -1 = dropped
}

type Cmd struct {
    op   string         // "join" | "leave" | "say" | "sent"
    id   string
    room string
    name string
    out  chan string
    done chan int       // "say": the hub signals it once the message is fanned out
    fd   int
    n    int            // "sent": bytes the writer has finished with
    msg  string
}

var hub = make(chan Cmd)

// Limits on what an unauthenticated client can make the server hold.
var max_message = 131072      // one chat message, bytes
var max_room = 64             // room name, bytes
var max_name = 32             // user name, bytes
var max_backlog = 8388608     // queued for one member before it is disconnected, bytes
var report_every = 262144     // a writer reports progress to the hub this often, bytes

extern "c" {
    header "sys/socket.h"
    fn shutdown(i32, i32) i32
}

// clip cuts s to at most max bytes without splitting a UTF-8 character.
func clip(s, max) (r) {
    r = s
    if len(s) <= max { return }
    b := bytes(substr(s, 0, max + 1))
    n := max
    while n > 0 && (byte_at(b, n) & 192) == 128 { n = n - 1 }
    r = substr(s, 0, n)
}

func cfg_port() (p) { p = 48500  e := env("MACHROOMS_PORT")  if e != "" { p = parse_int(e) } }
func cfg_title() (t) { t = env("MACHROOMS_TITLE")  if t == "" { t = "machin-rooms" } }

// ---- JSON message framing (what each client receives) ----

func jesc(s) (r) {
    r = replace(s, "\\", "\\\\")
    r = replace(r, "\"", "\\\"")
    r = replace(r, "\n", "\\n")
    r = replace(r, "\r", "")
    r = replace(r, "\t", " ")
}
func chat_json(room, name, text) (j) {
    j = "{\"type\":\"msg\",\"room\":\"" + jesc(room) + "\",\"name\":\"" + jesc(name) + "\",\"text\":\"" + jesc(text) + "\"}"
}
func sys_json(room, text, count) (j) {
    j = "{\"type\":\"sys\",\"room\":\"" + jesc(room) + "\",\"text\":\"" + jesc(text) + "\",\"count\":" + str(count) + "}"
}

// ---- the hub (single owner of the room registry) ----

func count_room(subs, room) (n) {
    n = 0
    for _, s := range subs { if s.room == room { n = n + 1 } }
}
// broadcast queues payload for every member of room. Delivery channels are unbounded so
// the hub never blocks; a member whose backlog passes max_backlog is disconnected instead.
func broadcast(subs, room, payload) {
    i := 0
    while i < len(subs) {
        s := subs[i]
        if s.room == room && s.pending >= 0 {
            queued := s.pending + len(payload)
            if queued > max_backlog {
                queued = -1
                x := shutdown(s.fd, 2)      // its reader and writer fail, then it leaves
            } else {
                s.out <- payload
            }
            s.pending = queued
            subs[i] = s
        }
        i = i + 1
    }
}

// The hub's memory is only reclaimed when its goroutine returns, and membership has to
// outlive any arena { } block. So after allocating about a budget's worth, the hub hands
// the member list to a fresh goroutine and returns, which frees everything it allocated.
// Commands wait in `hub` meanwhile, in order. inbox carries the n members handed over.
func hub_run(inbox, n) {
    subs := []Sub{}
    k := 0
    while k < n {
        s := <-inbox
        subs = append(subs, s)
        k = k + 1
    }
    chan_free(inbox)                        // the previous hub is done with it
    budget := 2097152 + n * 2048
    spent := 0
    while spent < budget {
        c := <-hub
        spent = spent + 1024 + len(c.msg) * 12 + len(subs) * 160
        if c.op == "join" {
            subs = append(subs, Sub{id: c.id, room: c.room, name: c.name, out: c.out, fd: c.fd, pending: 0})
            broadcast(subs, c.room, sys_json(c.room, c.name + " joined", count_room(subs, c.room)))
        }
        if c.op == "leave" {
            ns := []Sub{}
            for _, s := range subs { if s.id != c.id { ns = append(ns, s) } }
            subs = ns
            c.out <- "__close__"            // last send: the writer now frees the channel
            broadcast(subs, c.room, sys_json(c.room, c.name + " left", count_room(subs, c.room)))
        }
        if c.op == "say" {
            broadcast(subs, c.room, chat_json(c.room, c.name, c.msg))
            c.done <- 1
        }
        if c.op == "sent" {
            i := 0
            while i < len(subs) {
                s := subs[i]
                if s.id == c.id && s.pending >= 0 {
                    s.pending = s.pending - c.n
                    subs[i] = s
                }
                i = i + 1
            }
        }
    }
    next := make(chan Sub)
    go hub_run(next, len(subs))
    for _, s := range subs { next <- s }
}

// ---- a connection ----

// writer drains a connection's outbound channel and writes each broadcast as a WS text
// frame, until the hub sends "__close__". After a failed write it keeps draining, so
// nothing piles up, and it owns the channel's release.
func conn_writer(fd, id, out, done) {
    open := 1
    alive := 1
    unreported := 0
    while open == 1 {
        arena {                                        // frees each broadcast's frame
            m := <-out
            if m == "__close__" {
                open = 0
            } else {
                if alive == 1 {
                    f := ws_frame(1, bytes(m))
                    if write_bytes(fd, f) < len(f) {
                        alive = 0
                        x := shutdown(fd, 2)           // ends the reader too
                    }
                    unreported = unreported + len(m)
                    if unreported >= report_every {
                        hub <- Cmd{op: "sent", id: id, n: unreported}
                        unreported = 0
                    }
                }
            }
        }
    }
    chan_free(out)
    done <- 1                                          // the fd is no longer in use here
}

func room_ws(req) (res) {
    room := clip(query(req, "room"), max_room)
    if room == "" { room = "lobby" }
    name := clip(query(req, "name"), max_name)
    if name == "" { name = "anon-" + to_hex(rand_bytes(2)) }
    res = ws(req, func(c) {
        id := to_hex(rand_bytes(8))
        out := make(chan string)
        done := make(chan int)      // from the hub after each "say", from the writer at the end
        hub <- Cmd{op: "join", id: id, room: room, name: name, out: out, fd: c.fd}
        go conn_writer(c.fd, id, out, done)
        open := 1
        while open == 1 {
            arena {                                    // frees each message's memory
                text, ok := ws_next_text(c)
                open = ok                              // 0 = client closed / EOF
                if ok == 1 && text != "" {
                    hub <- Cmd{op: "say", room: room, name: name, done: done, msg: text}
                    x := <-done                        // one in flight: a flood can't fill `hub`
                }
            }
        }
        y := shutdown(c.fd, 2)  // unblocks a writer stuck on a client that stopped reading
        hub <- Cmd{op: "leave", id: id, room: room, name: name, out: out}
        x := <-done        // machweb closes the fd when we return; the writer must be done
        chan_free(done)
    })
}

// ---- the web client ----

func page() (h) {
    title := cfg_title()
    h = "<!doctype html><html><head><meta charset=\"utf-8\">" +
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" +
        "<title>" + title + "</title><style>" +
        "*{box-sizing:border-box}body{font:15px/1.5 -apple-system,Segoe UI,Roboto,sans-serif;margin:0;height:100vh;display:flex;flex-direction:column;background:#0f1115;color:#d7dbe0}" +
        "header{padding:.7rem 1rem;background:#171a21;border-bottom:1px solid #262b36;display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}" +
        "header h1{font-size:1rem;margin:0 .5rem 0 0;color:#fff}.count{margin-left:auto;color:#7d8590;font-size:.85rem}" +
        "input,button{font:inherit}input{background:#0f1115;border:1px solid #2b313c;color:#d7dbe0;border-radius:6px;padding:.35rem .5rem}" +
        "button{background:#1f6feb;color:#fff;border:0;border-radius:6px;padding:.4rem .9rem;cursor:pointer}button:hover{background:#388bfd}" +
        "#log{flex:1;overflow:auto;padding:1rem;margin:0;list-style:none}#log li{padding:.2rem 0}" +
        ".nm{color:#58a6ff;font-weight:600}.sys{color:#6e7681;font-style:italic}.dot{width:9px;height:9px;border-radius:50%;background:#555;display:inline-block;margin-right:.2rem}.dot.on{background:#3fb950}" +
        "footer{display:flex;gap:.5rem;padding:.7rem 1rem;background:#171a21;border-top:1px solid #262b36}#msg{flex:1}" +
        "</style></head><body>" +
        "<header><span class=\"dot\" id=\"st\"></span><h1>" + title + "</h1>" +
        "<input id=\"room\" value=\"lobby\" style=\"width:7rem\" placeholder=\"room\">" +
        "<input id=\"name\" placeholder=\"your name\" style=\"width:8rem\">" +
        "<button onclick=\"join()\">Join</button><span class=\"count\" id=\"count\"></span></header>" +
        "<ul id=\"log\"></ul>" +
        "<footer><input id=\"msg\" placeholder=\"type a message and press Enter\" autocomplete=\"off\"><button onclick=\"send()\">Send</button></footer>" +
        "<script>" +
        "let ws=null;" +
        "function esc(s){return s.replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]))}" +
        "function add(html){const l=document.getElementById('log');const li=document.createElement('li');li.innerHTML=html;l.appendChild(li);l.scrollTop=l.scrollHeight}" +
        "function join(){if(ws)ws.close();" +
        "const room=document.getElementById('room').value.trim()||'lobby';" +
        "const name=document.getElementById('name').value.trim()||('anon'+Math.floor(Math.random()*1000));" +
        "const proto=location.protocol==='https:'?'wss':'ws';" +
        "ws=new WebSocket(proto+'://'+location.host+'/ws?room='+encodeURIComponent(room)+'&name='+encodeURIComponent(name));" +
        "const st=document.getElementById('st');" +
        "ws.onopen=()=>{st.classList.add('on');add('<span class=sys>connected to #'+esc(room)+'</span>')};" +
        "ws.onclose=()=>{st.classList.remove('on');add('<span class=sys>disconnected</span>')};" +
        "ws.onmessage=e=>{const d=JSON.parse(e.data);" +
        "if(d.type==='sys'){add('<span class=sys>'+esc(d.text)+'</span>');document.getElementById('count').textContent=d.count+' online'}" +
        "else{add('<span class=nm>'+esc(d.name)+':</span> '+esc(d.text))}};}" +
        "function send(){const m=document.getElementById('msg');if(ws&&ws.readyState===1&&m.value){ws.send(m.value);m.value=''}}" +
        "document.getElementById('msg').addEventListener('keydown',e=>{if(e.key==='Enter')send()});" +
        "join();" +
        "</script></body></html>"
}

func handle(req) (res) {
    if is_ws_request(req) == 1 { res = room_ws(req)  return }
    p := req.path
    qi := index(p, "?")
    if qi >= 0 { p = substr(p, 0, qi) }
    if p == "/_health" { res = ok_json("{\"ok\":true,\"service\":\"machin-rooms\"}")  return }
    if p == "/" { res = ok_html(page())  return }
    res = not_found()
}

func main() {
    ws_set_max_message(max_message)
    set_max_body(65536)                 // no route takes a body
    go hub_run(make(chan Sub), 0)
    port := cfg_port()
    println("machin-rooms on http://localhost:" + str(port) + "  (WebSocket chat at /ws?room=&name=)")
    serve(port, func(req) { return handle(req) })
}
